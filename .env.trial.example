# Copy to .env.trial; never commit the completed file.
SUPPLYMIND_RELEASE_TAG=your-immutable-release-tag
SUPPLYMIND_JWT_SECRET=generate-a-random-value-with-at-least-32-characters
SUPPLYMIND_CREDENTIAL_KEY=generate-a-fernet-compatible-key
SUPPLYMIND_CORS_ORIGINS=http://trial-host:5173
SUPPLYMIND_CHAT_BASE_URL=https://your-approved-openai-compatible-endpoint/v1
SUPPLYMIND_CHAT_MODEL=your-approved-model
SUPPLYMIND_CHAT_API_KEY=replace-with-secret
SUPPLYMIND_EMBEDDING_BASE_URL=https://your-approved-openai-compatible-endpoint/v1
SUPPLYMIND_EMBEDDING_MODEL=your-approved-embedding-model
SUPPLYMIND_EMBEDDING_API_KEY=replace-with-secret
SUPPLYMIND_EMBEDDING_DIMENSION=1024
SUPPLYMIND_MCP_SERVICE_SECRET=generate-a-second-random-secret-for-mcp-tool-context
SUPPLYMIND_MCP_ALLOWED_HOSTS=mcp-server
SUPPLYMIND_A2A_PUBLIC_BASE_URL=https://supplymind.example.com
SUPPLYMIND_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
SUPPLYMIND_RERANK_BASE_URL=
SUPPLYMIND_RERANK_MODEL=
SUPPLYMIND_RERANK_API_KEY=
LITELLM_MASTER_KEY=replace-with-a-gateway-master-key
SUPPLYMIND_UPSTREAM_CHAT_BASE_URL=
SUPPLYMIND_UPSTREAM_CHAT_MODEL=
SUPPLYMIND_UPSTREAM_CHAT_API_KEY=
SUPPLYMIND_UPSTREAM_EMBEDDING_MODEL=
SUPPLYMIND_S3_ACCESS_KEY=replace-with-minio-access-key
SUPPLYMIND_S3_SECRET_KEY=replace-with-minio-secret-key
